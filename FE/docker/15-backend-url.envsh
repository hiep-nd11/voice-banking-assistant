#!/bin/sh
# Sourced by the official nginx entrypoint before template substitution.
# A trailing slash in proxy_pass would strip /api/ from upstream requests.
BACKEND_URL="${BACKEND_URL:-http://backend:8000}"
while [ "${BACKEND_URL%/}" != "$BACKEND_URL" ]; do
    BACKEND_URL="${BACKEND_URL%/}"
done

case "$BACKEND_URL" in
    http://*|https://*) ;;
    *) echo "BACKEND_URL must be an http:// or https:// origin." >&2; exit 1 ;;
esac

authority="${BACKEND_URL#*://}"
if ! printf '%s' "$authority" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9.-]*(:[0-9]{1,5})?$'; then
    echo "BACKEND_URL must contain only the backend origin, without /api, /docs, query or credentials." >&2
    exit 1
fi
export BACKEND_URL
