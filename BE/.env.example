# LLM: OpenAI-compatible endpoint; include /v1 if required by the provider.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=glm-4.6
# Banking data source (MCP). Never place these values in the public FE config.
MCP_BASE_URL=
MCP_API_KEY=
# ASR client appends /transcribe to this base URL.
ASR_BASE_URL=https://endpoint-5c01bb45-f992-4e76-86a8-30b2de404506.agentbase-runtime.aiplatform.vngcloud.vn
# Optional speech output; an empty key disables TTS.
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=gemini-3.1-flash-tts-preview
TTS_VOICE=Aoede
ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
MAX_AGENT_STEPS=5
AGENT_TIMEOUT_S=60
