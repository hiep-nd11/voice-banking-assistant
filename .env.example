# ==== Copy thành .env rồi điền giá trị ====

# LLM (OpenAI-compatible). Nếu bỏ trống LLM_API_KEY -> chế độ DEMO FALLBACK (không cần mạng).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=
TTS_VOICE=

# Khi chạy backend ngoài Docker (uvicorn local), DB là localhost:5433
DATABASE_URL=

# MCP server (voice-banking-assistant) — dữ liệu khách hàng mock (KH0001)
# Chạy: cd ../voice-banking-assistant && docker compose up --build
MCP_BASE_URL=
MCP_API_KEY=

# ASR Voice WebSocket API (VNG Cloud agentbase) — /transcribe cho file, /ws/voice cho stream
ASR_BASE_URL=

# TTS (Gemini). Rỗng TTS_API_KEY -> không phát audio, chỉ trả text.
TTS_BASE_URL=https://generativelanguage.googleapis.com
TTS_MODEL=gemini-3.1-flash-tts-preview
TTS_VOICE=Aoede

ALLOW_ORIGINS=http://localhost:3000
