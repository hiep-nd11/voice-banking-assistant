# ---- Bắt buộc ----
# Postgres (vDB GreenNode hoặc local). Schema "vb" được tạo bởi db/load_db.py
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Khóa để backend agent gọi MCP server (header X-Api-Key). Sinh: python -c "import secrets;print(secrets.token_urlsafe(32))"
MCP_API_KEY=

# ---- Tùy chọn ----
# Khóa riêng cho REST /api/* mà giao diện app gọi (mặc định = MCP_API_KEY)
UI_API_KEY=
# Domain giao diện được gọi REST từ trình duyệt, phân tách dấu phẩy
CORS_ORIGINS=
# Cố định "bây giờ" khi quay video/demo (dữ liệu mock chạy đến 25/10/2026)
DEMO_NOW=
# Thời gian sống của màn hình đã điền sẵn (phút)
ACTION_TTL_MINUTES=15
# Trần số tiền được điền sẵn qua giọng nói
MAX_PREFILL_TRANSFER=500000000
BANK_HOTLINE=tổng đài chăm sóc khách hàng in ở mặt sau thẻ
DB_POOL_MAX=5
LOG_LEVEL=INFO
# Chỉ dùng khi dev local: cho phép chạy không có MCP_API_KEY
ALLOW_NO_AUTH=false
# Gắn cố định server với 1 khách (app chỉ phục vụ tài khoản này).
# - stdio: bắt buộc.
# - HTTP sau MCP Gateway: NÊN đặt, vì Gateway có thể không chuyển tiếp header X-Customer-Id.
#   Khi đã đặt, request mang X-Customer-Id khác giá trị này sẽ bị từ chối.
VB_CUSTOMER_ID=KH0001




